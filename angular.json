{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "web": {
      "projectType": "application",
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "prefix": "finca",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/web/src/main.ts",
            "index": "apps/web/src/index.html",
            "tsConfig": "apps/web/tsconfig.app.json",
            "outputPath": "dist/web",
            "inlineStyleLanguage": "scss",
            "styles": [
              "designs/assets/styles.css",
              "designs/assets/motion.css",
              "packages/ui/src/styles.scss"
            ],
            "assets": [],
            "baseHref": "./"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "800kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "web:build:development",
            "tsConfig": "apps/web/tsconfig.spec.json",
            "include": ["../../../packages/ui/src/**/*.angular.spec.ts"]
          }
        }
      }
    },
    "extension": {
      "projectType": "application",
      "root": "apps/extension",
      "sourceRoot": "apps/extension/src",
      "prefix": "finca",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/extension/src/main.ts",
            "index": "apps/extension/src/index.html",
            "tsConfig": "apps/extension/tsconfig.app.json",
            "outputPath": "dist/extension",
            "inlineStyleLanguage": "scss",
            "styles": [
              "designs/assets/styles.css",
              "designs/assets/motion.css",
              "packages/ui/src/styles.scss"
            ],
            "assets": [],
            "baseHref": "./"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "800kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
