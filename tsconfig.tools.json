{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "chrome"],
    "noEmit": true
  },
  "include": [
    "packages/domain/**/*.ts",
    "packages/application/**/*.ts",
    "packages/storage/**/*.ts",
    "apps/api/**/*.ts",
    "apps/extension/src/background.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
